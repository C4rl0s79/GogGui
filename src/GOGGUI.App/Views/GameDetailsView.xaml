<Page
    x:Class="GOGGUI.Views.GameDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="24,16">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cover -->
                <Border Grid.Column="0" Width="120" Height="160" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Image x:Name="CoverImage" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Initials fallback -->
                        <TextBlock x:Name="CoverInitials"
                                   FontSize="28" FontWeight="Bold" Opacity="0.4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Title / meta -->
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SlugLabel" FontSize="12" Opacity="0.5"/>

                    <!-- Badges row -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,3">
                            <TextBlock x:Name="StatusBadgeLabel" FontSize="12" Foreground="White"/>
                        </Border>
                        <Border x:Name="SizeBadge" CornerRadius="4" Padding="8,3"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock x:Name="SizeLabel" FontSize="12" Opacity="0.7"/>
                        </Border>
                        <Border x:Name="VersionBadge" CornerRadius="4" Padding="8,3"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Visibility="Collapsed">
                            <TextBlock x:Name="VersionLabel" FontSize="12" Opacity="0.7"/>
                        </Border>
                        <Border x:Name="UpdateBadge" CornerRadius="4" Padding="8,3"
                                Background="#e85e00" Visibility="Collapsed">
                            <TextBlock x:Name="UpdateLabel" FontSize="12" Foreground="White"
                                       Text="🔄 Update available"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="ReleaseDateLabel" FontSize="12" Opacity="0.5"/>
                </StackPanel>

                <ProgressRing x:Name="LoadingRing" Grid.Column="2"
                              IsActive="False" Width="28" Height="28"
                              VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="20" MaxWidth="900">

                <!-- Actions -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" FlowDirection="LeftToRight">
                        <Button x:Name="AddToQueueButton"
                                Content="⬇️ Add to queue"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="AddToQueueButton_Click"/>
                        <Button x:Name="AddExtrasToQueueButton"
                                Content="🎨 Queue extras only"
                                Click="AddExtrasToQueueButton_Click"/>
                        <Button x:Name="OpenFolderButton"
                                Content="📁 Open folder"
                                Click="OpenFolderButton_Click"/>
                        <ToggleSwitch x:Name="ExtrasToggle"
                                      Header="Include extras"
                                      OffContent="No" OnContent="Yes"/>
                    </StackPanel>
                    <TextBlock x:Name="QueuedLabel" FontSize="12" Opacity="0.6"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Description -->
                <StackPanel x:Name="DescriptionPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="About" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DescriptionLabel" TextWrapping="Wrap"
                               FontSize="13" Opacity="0.85" MaxLines="8"/>
                </StackPanel>

                <!-- Metadata: installers + extras + DLC -->
                <StackPanel x:Name="MetadataPanel" Spacing="8" Visibility="Collapsed">

                    <TextBlock Text="Available Installers" FontSize="14" FontWeight="SemiBold"/>
                    <ListView x:Name="InstallersList" SelectionMode="None" MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Os}" FontSize="12" Opacity="0.6" Margin="12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Language}" FontSize="12" Opacity="0.6" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalSizeHuman}" FontSize="12" Opacity="0.6"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="Extras" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <ListView x:Name="ExtrasList" SelectionMode="None" MaxHeight="160">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,4">
                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                    <TextBlock Text="{Binding Type}" FontSize="12" Opacity="0.5"/>
                                    <TextBlock Text="{Binding TotalSizeHuman}" FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="DLCs" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <ListView x:Name="DlcList" SelectionMode="None" MaxHeight="160">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="13" Padding="0,4"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <TextBlock x:Name="NoMetadataLabel"
                           Text="No metadata found. Run ‘Update Metadata’ from the Library view."
                           FontSize="13" Opacity="0.5"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
