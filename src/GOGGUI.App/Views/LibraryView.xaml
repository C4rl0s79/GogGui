<Page
    x:Class="GOGGUI.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GOGGUI.Core.Models">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <Button x:Name="ScanButton" Content="🔍 Scan Library" Click="ScanButton_Click"/>
            <Button x:Name="SyncCacheButton" Content="📂 Sync Cache" Click="SyncCacheButton_Click"/>
            <Button x:Name="UpdateMetadataButton" Content="☁️ Update Metadata" Click="UpdateMetadataButton_Click"/>
            <Button x:Name="RefreshButton" Content="↻ Refresh" Click="RefreshButton_Click"/>
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24"/>
        </StackPanel>

        <!-- Status bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" Margin="0,0,0,16">
            <TextBlock x:Name="StatusLabel" Text="Ready" FontSize="13"/>
            <TextBlock x:Name="GameCountLabel" Text="" FontSize="13" Opacity="0.6"/>
            <TextBlock x:Name="LibraryDirLabel" Text="" FontSize="13" Opacity="0.5"
                       TextTrimming="CharacterEllipsis" MaxWidth="400"/>
        </StackPanel>

        <!-- Games Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="GamesRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="200" MinItemHeight="200"
                                       ItemsStretch="Fill" MinColumnSpacing="12" MinRowSpacing="12"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:GameState">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2"/>
                                <TextBlock Text="{x:Bind Slug}" FontSize="11" Opacity="0.5"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                    <Border Background="#1a7f37" CornerRadius="4" Padding="4,1"
                                            Visibility="{x:Bind HasInstallers}">
                                        <TextBlock Text="✅ installer" FontSize="10" Foreground="White"/>
                                    </Border>
                                    <Border Background="#6e40c9" CornerRadius="4" Padding="4,1"
                                            Visibility="{x:Bind HasExtras}">
                                        <TextBlock Text="🎨 extras" FontSize="10" Foreground="White"/>
                                    </Border>
                                    <Border Background="#bf8700" CornerRadius="4" Padding="4,1"
                                            Visibility="{x:Bind HasMetadata}">
                                        <TextBlock Text="💾 meta" FontSize="10" Foreground="White"/>
                                    </Border>
                                    <Border Background="#0969da" CornerRadius="4" Padding="4,1"
                                            Visibility="{x:Bind HasXml}">
                                        <TextBlock Text="📄 xml" FontSize="10" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Status}" FontSize="11"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Margin="0,4,0,0"/>
                                <Button Content="Download" HorizontalAlignment="Stretch"
                                        Tag="{x:Bind Slug}" Click="DownloadButton_Click"
                                        Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
