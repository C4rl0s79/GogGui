<Page
    x:Class="GOGGUI.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GOGGUI.ViewModels">

    <Page.Resources>
        <DataTemplates x:Key="LibraryTemplate">
            <!-- Game tile template -->
        </DataTemplates>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
            <Button x:Name="RefreshButton" Content="Refresh Library" Width="120"/>
            <Button x:Name="LoginButton" Content="Login" Width="80"/>
            <Button x:Name=" DownloadAllButton" Content="Update Metadata" Width="140"/>
            <ToggleSwitch x:Name="ExtrasToggle" Header="Include Extras" OffContent="No" OnContent="Yes" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Game Library Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GamesListView">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapperGrid ColumnWidth="200" RowSpacing="15" ColumnSpacing="15"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Game tile -->
                        <StackPanel Width="180" Margin="5">
                            <Image Height="100" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding Title}" FontSize="14" Margin="0,8,0,4" TextWrapping="Wrap"/>
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE80D;" Foreground="Green"/>
                                <TextBlock Text="{Binding Status}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
