<Page
    x:Class="GOGGUI.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GOGGUI.Core.Models">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search games..."
                         Width="220"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="FilterCombo" Header="" Width="160"
                          SelectionChanged="FilterCombo_SelectionChanged">
                    <ComboBoxItem Content="All games" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Complete" Tag="Complete"/>
                    <ComboBoxItem Content="Not downloaded" Tag="NotDownloaded"/>
                    <ComboBoxItem Content="Update available" Tag="UpdateAvailable"/>
                    <ComboBoxItem Content="Has extras" Tag="HasExtras"/>
                </ComboBox>
                <ComboBox x:Name="SortCombo" Header="" Width="130"
                          SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem Content="Sort: Title" Tag="Title" IsSelected="True"/>
                    <ComboBoxItem Content="Sort: Size" Tag="Size"/>
                    <ComboBoxItem Content="Sort: Status" Tag="Status"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ScanButton" Content="Scan" Click="ScanButton_Click"
                        ToolTipService.ToolTip="Scan library folder"/>
                <Button x:Name="CheckUpdatesButton" Content="Check Updates"
                        Click="CheckUpdatesButton_Click"/>
                <Button x:Name="SyncCacheButton" Content="Sync Cache"
                        Click="SyncCacheButton_Click"/>
                <Button x:Name="UpdateMetadataButton" Content="Update Metadata"
                        Click="UpdateMetadataButton_Click"/>
                <AppBarSeparator/>
                <ToggleButton x:Name="GridViewToggle" IsChecked="True"
                              Click="ViewToggle_Click"
                              ToolTipService.ToolTip="Grid view">
                    <FontIcon Glyph="&#xF0E2;"/>
                </ToggleButton>
                <ToggleButton x:Name="ListViewToggle" IsChecked="False"
                              Click="ViewToggle_Click"
                              ToolTipService.ToolTip="List view">
                    <FontIcon Glyph="&#xE8FD;"/>
                </ToggleButton>
                <ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24"/>
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,14">
            <TextBlock x:Name="StatusLabel" Text="Ready" FontSize="13"/>
            <TextBlock x:Name="GameCountLabel" FontSize="13" Opacity="0.6"/>
            <Border x:Name="UpdatesBadge" Background="#cf222e" CornerRadius="10"
                    Padding="8,2" Visibility="Collapsed">
                <TextBlock x:Name="UpdatesBadgeLabel" Foreground="White" FontSize="12"/>
            </Border>
            <TextBlock x:Name="LibraryDirLabel" FontSize="12" Opacity="0.45"
                       TextTrimming="CharacterEllipsis" MaxWidth="350"/>
        </StackPanel>

        <!-- Games - Grid view -->
        <ScrollViewer x:Name="GridScrollViewer" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="GamesRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="210" MinItemHeight="240"
                                       ItemsStretch="Fill"
                                       MinColumnSpacing="12" MinRowSpacing="12"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:GameState">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="0"
                                Tapped="GameCard_Tapped"
                                DataContext="{x:Bind}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="110"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#1e1e2e"
                                        CornerRadius="8,8,0,0">
                                    <Grid>
                                        <Image Source="{x:Bind CoverPath, Mode=OneWay}"
                                               Stretch="UniformToFill"/>
                                        <Border Background="#2d2d3f"
                                                Visibility="{x:Bind NoCover, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{x:Bind TitleInitials, Mode=OneWay}"
                                                       FontSize="32" FontWeight="Bold"
                                                       Opacity="0.4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Padding="12,10" Spacing="5">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               MaxLines="2"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Background="#1a7f37" CornerRadius="4" Padding="4,1"
                                                Visibility="{x:Bind HasInstallers, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="OK" FontSize="10" Foreground="White"/>
                                        </Border>
                                        <Border Background="#6e40c9" CornerRadius="4" Padding="4,1"
                                                Visibility="{x:Bind HasExtras, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Extras" FontSize="10" Foreground="White"/>
                                        </Border>
                                        <Border Background="#bf8700" CornerRadius="4" Padding="4,1"
                                                Visibility="{x:Bind HasMetadata, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Meta" FontSize="10" Foreground="White"/>
                                        </Border>
                                        <Border Background="#cf222e" CornerRadius="4" Padding="4,1"
                                                Visibility="{x:Bind IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Update" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Content="Download" Tag="{x:Bind Slug}"
                                            Click="DownloadButton_Click"
                                            HorizontalAlignment="Right"
                                            Padding="8,4" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Games - List view -->
        <ListView x:Name="GamesListView" Grid.Row="2"
                  Visibility="Collapsed"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="GamesListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:GameState">
                    <Grid Padding="4,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36"
                                Background="#2d2d3f" CornerRadius="4">
                            <TextBlock Text="{x:Bind TitleInitials, Mode=OneWay}" FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.5"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontSize="13"
                                   VerticalAlignment="Center" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Slug, Mode=OneWay}" FontSize="11"
                                   Opacity="0.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind InstallersSize, Mode=OneWay}"
                                   FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind Status, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
