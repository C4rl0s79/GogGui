<Window
    x:Class="GOGGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GOGGUI - GOG Library Manager">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="20,15">
            <TextBlock Text="GOGGUI" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Library Manager for lgogdownloader" FontSize="14" Opacity="0.7" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Frame Grid.Row="1" x:Name="ContentFrame" NavigationFailed="ContentFrame_NavigationFailed"/>

        <!-- Status Bar -->
        <StackPanel Grid.Row="2" Padding="20,10" Background="Multiply">
            <StackPanel Orientation="Horizontal" Spacing="15">
                <TextBlock x:Name="StatusLabel" Text="Ready"/>
                <TextBlock x:Name="LoginStatusLabel" Text="Login: Not checked" Foreground="Orange"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
